# Azure Environment Configuration
AZURE_ENV_NAME=pennie-prod
AZURE_LOCATION=uksouth
AZURE_SUBSCRIPTION_ID=your-subscription-id-here
AZURE_TENANT_ID=your-tenant-id-here

# Azure Resource Group
AZURE_RESOURCE_GROUP=TMinus15Agents

# Azure AI Foundry (UK South for data residency)
AZURE_AI_HUB_NAME=knowall-ai-foundry
AZURE_AI_PROJECT_NAME=pennie-project-prod
AZURE_AI_PROJECT_CONNECTION_STRING=

# Application Insights (to be created)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Container Registry (to be created or specify existing)
AZURE_CONTAINER_REGISTRY_ENDPOINT=
AZURE_CONTAINER_REGISTRY_NAME=

# Container Apps Environment (to be created)
AZURE_CONTAINER_ENVIRONMENT_NAME=pennie-env

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-06

# Azure DevOps Integration
AZURE_DEVOPS_ORG=your-org-name
AZURE_DEVOPS_PAT=abcdef1234567890abcdef1234567890abcdef1234567890

# Microsoft Teams Bot
# Note: TEAMS_APP_ID and TEAMS_APP_PASSWORD are managed via GitHub Secrets
# and set as environment variables during deployment
TEAMS_APP_ID=your-teams-app-id
TEAMS_APP_PASSWORD=your-teams-app-password

# Local Development
PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# Azure Functions
AZURE_FUNCTIONS_APP_NAME=pennie-functions
AZURE_FUNCTIONS_STORAGE_ACCOUNT=

# Optional: GitHub Integration
GITHUB_TOKEN=
GITHUB_ORG=
GITHUB_REPO=

# Deployed Agents
# UK South (OpenAI Assistants API) - NOT USED (region unavailable)
AZURE_AI_ASSISTANT_ID=asst_xxxxxxxxxxxxxxxxxxxxxxxx

# East US 2 (OpenAI Assistants API with gpt-5-chat) - NOT USED (incompatible model)
AZURE_AI_ASSISTANT_ID_EASTUS2=asst_xxxxxxxxxxxxxxxxxxxxxxxx

# East US 2 (Azure AI Foundry Agents API with gpt-4o) - ACTIVE ✓
AZURE_AI_FOUNDRY_AGENT_ID=asst_xxxxxxxxxxxxxxxxxxxxxxxx
AZURE_AI_FOUNDRY_PROJECT=your-project-name
AZURE_AI_FOUNDRY_ENDPOINT=https://your-endpoint.services.ai.azure.com
AZURE_AI_FOUNDRY_MODEL=gpt-4o

# Pennie Backend Function URLs (populated after deployment)
PENNIE_BACKEND_URL=https://pennie-backend-prod.azurewebsites.net
PENNIE_BACKEND_WIT_CREATE_URL=https://pennie-backend-prod.azurewebsites.net/api/wit_create_work_item
PENNIE_BACKEND_WIT_ADD_CHILD_URL=https://pennie-backend-prod.azurewebsites.net/api/wit_add_child_work_items
PENNIE_BACKEND_FUNCTION_KEY=your-function-key-here

# Resource Account for Meeting Invites
# Created via: ./scripts/setup-resource-account.sh pennie@knowall.ai
# Users can invite this email address to meetings and Pennie will auto-join
#
# IMPORTANT: The resource account needs a license with Exchange Online for a mailbox:
#   - Option A (free): "Microsoft Teams Phone Resource Account" - add via M365 Admin > Purchase services
#   - Option B (paid): "Exchange Online Plan 1" (~£3.30/month)
#
RESOURCE_ACCOUNT_EMAIL=pennie@knowall.ai
RESOURCE_ACCOUNT_USER_ID=
